---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Sparkles, Check, ArrowRight } from 'lucide-react';
import { LandingNavbar } from '@/components/landing/LandingNavbar';
---

<BaseLayout
  title="Paket Harga — SEO Content & Prompt Operating System"
  description="Pilihan paket harga fleksibel untuk SEO Specialist, Content Writer, Agensi Digital, dan Website Owner."
  isAppLayout={false}
>
  <LandingNavbar client:only="react" />

  <main class="py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <span class="rounded-full bg-blue-100 px-3 py-1 text-xs font-bold text-blue-700 dark:bg-blue-900/60 dark:text-blue-300">
          Transparent Pricing
        </span>
        <h1 class="mt-4 text-3xl font-black tracking-tight text-slate-900 dark:text-white sm:text-5xl">
          Pilihan Paket Sesuai Skala Konten Anda
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-sm text-slate-600 dark:text-slate-300">
          Mulai secara gratis di browser Anda, upgrade ke integrasi Cloud Supabase tanpa batas.
        </p>
      </div>

      <div class="mt-16 grid grid-cols-1 gap-8 md:grid-cols-3">
        {/* Starter Plan */}
        <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-soft dark:border-slate-800 dark:bg-slate-900">
          <h3 class="text-lg font-bold text-slate-900 dark:text-white">Community Edition</h3>
          <p class="mt-1 text-xs text-slate-500">Cocok untuk blogger & SEO freelancer</p>
          <div class="mt-6">
            <span class="text-4xl font-black text-slate-900 dark:text-white">Gratis</span>
            <span class="text-xs text-slate-500"> / selamanya</span>
          </div>

          <ul class="mt-6 space-y-3 text-xs text-slate-600 dark:text-slate-300">
            <li class="flex items-center gap-2.5"><Check className="h-4 w-4 text-emerald-500" /> Local Storage 100% di browser</li>
            <li class="flex items-center gap-2.5"><Check className="h-4 w-4 text-emerald-500" /> Akses 40 Master Prompt Templates</li>
            <li class="flex items-center gap-2.5"><Check className="h-4 w-4 text-emerald-500" /> Impor Excel Kalender 30 Hari</li>
            <li class="flex items-center gap-2.5"><Check className="h-4 w-4 text-emerald-500" /> Formatter Markdown, JSON, YAML</li>
          </ul>

          <a href="/dashboard" class="mt-8 block text-center rounded-xl bg-slate-100 py-3 text-xs font-bold text-slate-800 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-200">
            Gunakan Sekarang
          </a>
        </div>

        {/* Pro Plan */}
        <div class="relative rounded-2xl border-2 border-blue-600 bg-white p-8 shadow-xl dark:bg-slate-900">
          <span class="absolute -top-3 right-6 rounded-full bg-blue-600 px-3 py-0.5 text-[10px] font-bold uppercase tracking-wider text-white">
            Paling Populer
          </span>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white">Pro Specialist</h3>
          <p class="mt-1 text-xs text-slate-500">Untuk SEO Specialist & In-House Content Team</p>
          <div class="mt-6">
            <span class="text-4xl font-black text-blue-600 dark:text-blue-400">Rp 199.000</span>
            <span class="text-xs text-slate-500"> / bulan</span>
          </div>

          <ul class="mt-6 space-y-3 text-xs text-slate-600 dark:text-slate-300">
            <li class="flex items-center gap-2.5"><Check className="h-4 w-4 text-emerald-500" /> Semua fitur Community Edition</li>
            <li class="flex items-center gap-2.5"><Check className="h-4 w-4 text-emerald-500" /> Unlimited Projects & Calendars</li>
            <li class="flex items-center gap-2.5"><Check className="h-4 w-4 text-emerald-500" /> Bulk Generator dengan ekspor .ZIP</li>
            <li class="flex items-center gap-2.5"><Check className="h-4 w-4 text-emerald-500" /> AI Query Fan-Out & Schema Engine</li>
            <li class="flex items-center gap-2.5"><Check className="h-4 w-4 text-emerald-500" /> Supabase Cloud Database Sync</li>
          </ul>

          <a href="/dashboard" class="mt-8 block text-center rounded-xl bg-blue-600 py-3 text-xs font-bold text-white shadow-md hover:bg-blue-700">
            Mulai Pro Trial
          </a>
        </div>

        {/* Agency Plan */}
        <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-soft dark:border-slate-800 dark:bg-slate-900">
          <h3 class="text-lg font-bold text-slate-900 dark:text-white">Agency Scale</h3>
          <p class="mt-1 text-xs text-slate-500">Untuk SEO & Content Marketing Agency</p>
          <div class="mt-6">
            <span class="text-4xl font-black text-slate-900 dark:text-white">Rp 599.000</span>
            <span class="text-xs text-slate-500"> / bulan</span>
          </div>

          <ul class="mt-6 space-y-3 text-xs text-slate-600 dark:text-slate-300">
            <li class="flex items-center gap-2.5"><Check className="h-4 w-4 text-emerald-500" /> Semua fitur Pro Specialist</li>
            <li class="flex items-center gap-2.5"><Check className="h-4 w-4 text-emerald-500" /> Multi-Seat Team Collaboration</li>
            <li class="flex items-center gap-2.5"><Check className="h-4 w-4 text-emerald-500" /> Custom Prompt Framework Creator</li>
            <li class="flex items-center gap-2.5"><Check className="h-4 w-4 text-emerald-500" /> Dedicated Cloud PostgreSQL & RLS</li>
            <li class="flex items-center gap-2.5"><Check className="h-4 w-4 text-emerald-500" /> Priority Support 24/7</li>
          </ul>

          <a href="/dashboard" class="mt-8 block text-center rounded-xl bg-slate-900 py-3 text-xs font-bold text-white hover:bg-black dark:bg-slate-800">
            Hubungi Tim Agensi
          </a>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
