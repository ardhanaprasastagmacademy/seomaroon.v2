---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { INITIAL_PROMPT_TEMPLATES } from '@/lib/storage/initial-data';
import { Sparkles, Layers, ArrowRight, CheckCircle2 } from 'lucide-react';
import { LandingNavbar } from '@/components/landing/LandingNavbar';
---

<BaseLayout
  title="Katalog 5 Master Prompt SEO / AEO / GEO Terpadu — SEO Prompt Studio"
  description="Koleksi 5 Master Prompt SEO, AEO, dan GEO terpadu standar industri: Single Commercial Authority B2B, optimasi artikel pilar otoritas, komparasi produk, tutorial How-To, dan SEO lokal."
  isAppLayout={false}
>
  <LandingNavbar client:only="react" />

  <main class="py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50/60 px-3.5 py-1 text-xs font-semibold text-blue-700 dark:border-blue-900/50 dark:bg-blue-950/40 dark:text-blue-300">
          <Sparkles className="h-3.5 w-3.5" />
          <span>Kompilasi 5 Master Terpadu Generasi Baru</span>
        </div>
        <h1 class="mt-4 text-3xl font-black tracking-tight text-slate-900 dark:text-white sm:text-5xl">
          5 Master Prompt Templates Terpadu
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-sm text-slate-600 dark:text-slate-300">
          Template prompt standar industri terlengkap hasil penggabungan framework terbaik: E-E-A-T, Answer Engine Optimization (AEO), Generative Engine Optimization (GEO), Local SEO, dan High-Conversion BOFU.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {INITIAL_PROMPT_TEMPLATES.map((tpl) => (
          <div class="flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-6 shadow-soft transition-all hover:border-blue-300 hover:shadow-md dark:border-slate-800 dark:bg-slate-900">
            <div>
              <div class="flex items-center justify-between">
                <span class="flex h-7 w-9 items-center justify-center rounded-lg bg-blue-600 text-xs font-black text-white shadow-sm">
                  {tpl.number < 10 ? '0' + tpl.number : tpl.number}
                </span>
                <span class="rounded-md bg-slate-100 px-2 py-0.5 text-[10px] font-bold text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                  {tpl.category}
                </span>
              </div>

              <h3 class="mt-3 text-sm font-bold text-slate-900 line-clamp-2 dark:text-white">
                {tpl.name}
              </h3>
              <p class="mt-2 text-xs text-slate-600 line-clamp-3 leading-relaxed dark:text-slate-400">
                {tpl.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </main>
</BaseLayout>
