---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { INITIAL_PROMPT_TEMPLATES } from '@/lib/storage/initial-data';
import { Sparkles, Layers, ArrowRight, CheckCircle2 } from 'lucide-react';
import { LandingNavbar } from '@/components/landing/LandingNavbar';
---

<BaseLayout
  title="Katalog Prompt SEO Template 04–40 — SEO Prompt Studio"
  description="Koleksi lengkap 40 Master Prompt SEO AEO GEO siap pakai: optimasi artikel pilar, review produk komparasi, refresh konten lama, dan SEO lokal."
  isAppLayout={false}
>
  <LandingNavbar client:only="react" />

  <main class="py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-3xl font-black tracking-tight text-slate-900 dark:text-white sm:text-5xl">
          Direktori Master Prompt SEO (04–40)
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-sm text-slate-600 dark:text-slate-300">
          Template prompt standar industri yang dirancang dengan prinsip E-E-A-T, Answer Engine Optimization (AEO), dan Generative Engine Optimization (GEO).
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {INITIAL_PROMPT_TEMPLATES.map((tpl) => (
          <div class="flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-6 shadow-soft transition-all hover:border-blue-300 hover:shadow-md dark:border-slate-800 dark:bg-slate-900">
            <div>
              <div class="flex items-center justify-between">
                <span class="flex h-7 w-9 items-center justify-center rounded-lg bg-blue-600 text-xs font-black text-white shadow-sm">
                  {tpl.number < 10 ? '0' + tpl.number : tpl.number}
                </span>
                <span class="rounded-md bg-slate-100 px-2 py-0.5 text-[10px] font-bold text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                  {tpl.category}
                </span>
              </div>

              <h3 class="mt-3 text-sm font-bold text-slate-900 line-clamp-2 dark:text-white">
                {tpl.name}
              </h3>
              <p class="mt-2 text-xs text-slate-600 line-clamp-3 leading-relaxed dark:text-slate-400">
                {tpl.description}
              </p>
            </div>

            <div class="mt-6 border-t border-slate-100 pt-4 dark:border-slate-800">
              <a
                href={`/prompt-builder?templateId=${tpl.id}`}
                class="flex items-center justify-center gap-1.5 rounded-xl bg-blue-50 py-2 text-xs font-bold text-blue-700 transition-all hover:bg-blue-600 hover:text-white dark:bg-blue-950/60 dark:text-blue-300 dark:hover:bg-blue-600"
              >
                <Sparkles className="h-3.5 w-3.5" />
                <span>Gunakan di Studio</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </main>
</BaseLayout>
